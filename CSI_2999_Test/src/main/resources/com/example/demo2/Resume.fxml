<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" style="-fx-background-color: #E6E4FF;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo2.ResumeController">

    <padding>
        <Insets bottom="40" left="40" right="40" top="40" />
    </padding>

    <!-- HEADER -->
    <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Resume" />

    <!-- UPLOAD BUTTON -->
    <Button id="addApplicationBtn" onAction="#uploadResume" stylesheets="@style.css" text="Upload Resume" />

    <!-- RESUME LIST -->
    <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
        <VBox fx:id="resumeListContainer" spacing="12" />
    </ScrollPane>

</VBox>
