<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700" prefWidth="1100" style="-fx-background-color: #E6E4FF;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo2.ApplicationsListController">



    <!-- CENTER CONTENT -->
    <center>
        <VBox spacing="25">

            <padding>
                <Insets bottom="40" left="40" right="40" top="40" />
            </padding>

            <!-- TITLE -->
            <Label style="-fx-font-size: 26; -fx-font-weight: bold;" text="ALL APPLICATIONS" />

            <!-- SCROLLABLE LIST -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">

                <VBox fx:id="applicationListContainer" spacing="15" />
            </ScrollPane>

            <!-- ADD BUTTON -->
            <HBox alignment="CENTER_RIGHT">
                <Button onAction="#handleAddApplication" style="-fx-background-color: #0F172A; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand;" text="ADD APPLICATION" />
            </HBox>

        </VBox>
    </center>

</BorderPane>
