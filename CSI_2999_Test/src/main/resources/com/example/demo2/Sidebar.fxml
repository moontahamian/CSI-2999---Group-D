<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER"
      spacing="35"
      style="-fx-background-color: #0F172A; -fx-padding: 50 0 0 0;"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.demo2.SidebarController">

    <Button fx:id="homeBtn"
            onAction="#goToDashboard"
            style="-fx-background-color: transparent; -fx-cursor: hand;"
            text="🏠"
            textFill="#ffb200" />

    <Button fx:id="applicationsBtn"
            onAction="#goToApplications"
            style="-fx-background-color: transparent; -fx-cursor: hand;"
            text="🗐"
            textFill="WHITE" />

    <Button fx:id="calendarBtn"
            onAction="#goToCalendar"
            style="-fx-background-color: transparent; -fx-cursor: hand;"
            text="📅"
            textFill="WHITE" />

    <Region VBox.vgrow="ALWAYS" />

    <Button fx:id="logoutBtn"
            onAction="#logout"
            style="-fx-background-color: transparent; -fx-cursor: hand;"
            text="➜]"
            textFill="WHITE" />

</VBox>
