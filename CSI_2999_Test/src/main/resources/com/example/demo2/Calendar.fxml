<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="699.0" prefWidth="1099.0"
            style="-fx-background-color: #E6E4FF;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo2.CalendarController">

   <center>
      <VBox spacing="30">

         <padding>
            <Insets bottom="40" left="40" right="40" top="40"/>
         </padding>

         <!-- HEADER -->
         <HBox spacing="20">
            <Text strokeType="OUTSIDE" strokeWidth="0.0"
                  text="Calendar" textAlignment="CENTER">
               <font>
                  <Font name="System Bold" size="30.0"/>
               </font>
            </Text>
         </HBox>

         <StackPane prefHeight="578.0" prefWidth="983.0" VBox.vgrow="ALWAYS">
            <children>

               <HBox prefWidth="983.0" spacing="20">

                  <VBox prefWidth="983.0" spacing="10"
                        style="-fx-background-color: white;
                                     -fx-background-radius: 12;
                                     -fx-padding: 15;"
                        HBox.hgrow="ALWAYS">

                     <!-- NAVIGATION ROW -->
                     <HBox alignment="TOP_CENTER"
                           prefHeight="38.0" prefWidth="953.0">

                        <Button fx:id="calendar_button_left"
                                styleClass="calendar-nav-btn"
                                text="&lt;"
                                mnemonicParsing="false">
                           <HBox.margin>
                              <Insets right="20.0"/>
                           </HBox.margin>
                        </Button>

                        <Label fx:id="calendar_text_month" text="September">
                           <font>
                              <Font name="System Bold" size="24.0"/>
                           </font>
                           <HBox.margin>
                              <Insets right="10.0"/>
                           </HBox.margin>
                        </Label>

                        <Label fx:id="calendar_text_year" text="2026">
                           <font>
                              <Font name="System Bold" size="24.0"/>
                           </font>
                        </Label>

                        <Button fx:id="calendar_button_right"
                                styleClass="calendar-nav-btn"
                                text="&gt;"
                                mnemonicParsing="false">
                           <HBox.margin>
                              <Insets left="20.0"/>
                           </HBox.margin>
                        </Button>

                     </HBox>

                     <!-- DIVIDER -->
                     <HBox prefHeight="5.0" prefWidth="953.0"
                           style="-fx-background-color: #112c7e;"/>

                     <!-- DAY HEADERS -->
                     <HBox alignment="TOP_CENTER"
                           prefHeight="28.0" prefWidth="953.0"
                           spacing="112.0">
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Su">
                           <font><Font name="System Bold" size="20.0"/></font>
                        </Text>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Mo">
                           <font><Font name="System Bold" size="20.0"/></font>
                        </Text>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Tu">
                           <font><Font name="System Bold" size="20.0"/></font>
                        </Text>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="We">
                           <font><Font name="System Bold" size="20.0"/></font>
                        </Text>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Th">
                           <font><Font name="System Bold" size="20.0"/></font>
                        </Text>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Fr">
                           <font><Font name="System Bold" size="20.0"/></font>
                        </Text>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Sa">
                           <font><Font name="System Bold" size="20.0"/></font>
                        </Text>
                     </HBox>

                     <!-- CALENDAR GRID -->
                     <GridPane fx:id="calendar_grid"
                               gridLinesVisible="true"
                               prefHeight="419.0" prefWidth="992.0"
                               style="-fx-border-color: #e2e8f0;"
                               VBox.vgrow="ALWAYS">
                        <columnConstraints>
                           <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                           <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                           <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                           <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                           <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                           <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                           <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                        </columnConstraints>
                        <rowConstraints>
                           <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                           <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                           <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                           <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                           <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                           <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                        </rowConstraints>
                     </GridPane>

                  </VBox>
               </HBox>

               <!-- POPUP -->
               <VBox fx:id="calendar_popup"
                     alignment="TOP_CENTER"
                     maxHeight="-Infinity" maxWidth="-Infinity"
                     prefHeight="488.0" prefWidth="417.0"
                     style="-fx-background-color: white;
                                 -fx-border-color: #112c7e;
                                 -fx-border-width: 5;
                                 -fx-border-radius: 12;
                                 -fx-background-radius: 12;
                                 -fx-effect: dropshadow(gaussian, rgba(17,44,126,0.2), 12, 0, 0, 4);"
                     visible="false"
                     StackPane.alignment="CENTER">

                  <!-- POPUP HEADER -->
                  <HBox alignment="TOP_RIGHT"
                        prefHeight="58.0" prefWidth="401.0">

                     <HBox prefHeight="56.0" prefWidth="305.0">
                        <Label fx:id="calendar_popup_date_label"
                               prefHeight="84.0" prefWidth="305.0"
                               text="03/02/2026"
                               style="-fx-text-fill: #112c7e;">
                           <font>
                              <Font name="System Bold" size="30.0"/>
                           </font>
                           <HBox.margin>
                              <Insets top="5.0"/>
                           </HBox.margin>
                        </Label>
                     </HBox>

                     <HBox alignment="TOP_RIGHT"
                           prefHeight="57.0" prefWidth="73.0">
                        <Button fx:id="calendar_popup_button_x"
                                styleClass="calendar-close-btn"
                                text="X"
                                mnemonicParsing="false">
                           <HBox.margin>
                              <Insets right="5.0" top="5.0"/>
                           </HBox.margin>
                        </Button>
                     </HBox>

                  </HBox>

                  <!-- TITLE ROW -->
                  <HBox maxHeight="-Infinity" maxWidth="-Infinity"
                        prefHeight="111.0" prefWidth="401.0">
                     <Label fx:id="calendar_popup_title_label"
                            prefHeight="95.0" prefWidth="147.0"
                            text="Title:"
                            style="-fx-text-fill: #112c7e;">
                        <font>
                           <Font name="System Bold" size="25.0"/>
                        </font>
                     </Label>
                     <TextArea fx:id="calendar_popup_title_textarea"
                               styleClass="calendar-textarea"
                               maxHeight="-Infinity" maxWidth="-Infinity"
                               prefHeight="98.0" prefWidth="392.0"
                               promptText="This text appears on the calendar"
                               wrapText="true">
                        <HBox.margin>
                           <Insets bottom="5.0" left="5.0" right="5.0" top="15.0"/>
                        </HBox.margin>
                     </TextArea>
                  </HBox>

                  <!-- DIVIDER -->
                  <HBox prefHeight="5.0" prefWidth="401.0"
                        style="-fx-background-color: #112c7e;"/>

                  <!-- NOTES ROW -->
                  <HBox prefHeight="423.0" prefWidth="401.0">
                     <TextArea fx:id="calendar_popup_notes_textarea"
                               styleClass="calendar-textarea"
                               maxHeight="-Infinity" maxWidth="-Infinity"
                               prefHeight="415.0" prefWidth="409.0"
                               promptText="Notes go here"
                               wrapText="true">
                        <HBox.margin>
                           <Insets bottom="5.0" left="5.0" right="5.0" top="15.0"/>
                        </HBox.margin>
                     </TextArea>
                  </HBox>

               </VBox>

            </children>
         </StackPane>

      </VBox>
   </center>

</BorderPane>